  "bugs": {
    "url": "https://github.com/Dev-Nadson/ToDo-server/issues"
  },
  "homepage": "https://github.com/Dev-Nadson/ToDo-server#readme",
  "dependencies": {
    "@paralleldrive/cuid2": "github:paralleldrive/cuid2",
    "dotenv": "^17.2.3",
    "fastify": "^5.6.2",
    "knex": "^3.1.0",
    "pg": "^8.16.3",
    "zod": "^4.2.0"
  },
  "devDependencies": {
    "@types/node": "^25.0.2",
    "tsc": "^2.0.4",
    "tsx": "^4.21.0"
  }
}